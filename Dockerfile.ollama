# Dockerfile.ollama - Custom Ollama image with pre-loaded models
FROM ollama/ollama:latest

# Set environment to run without interactive prompts
ENV OLLAMA_HOST=0.0.0.0:11434

# Create a script to pre-load models
RUN mkdir -p /root/.ollama

# Start Ollama in background, pull models, then stop
RUN ollama serve & \
    sleep 5 && \
    ollama pull nomic-embed-text && \
    ollama pull qwen2.5:3b && \
    pkill ollama && \
    sleep 2

# Default command
CMD ["ollama", "serve"]
